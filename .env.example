# Supabase
NEXT_PUBLIC_SUPABASE_URL=              # Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=  # "anon / public" key from the same page
SUPABASE_SERVICE_ROLE_KEY=             # "service_role" key (server-only, never expose to browser)

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # Publishable key from Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=                     # Secret key from the same page
STRIPE_WEBHOOK_SECRET=                 # Webhook signing secret (whsec_...) from Stripe → Webhooks

# Resend (email)
RESEND_API_KEY=                        # API key from resend.com/api-keys
RESEND_FROM_EMAIL=onboarding@resend.dev  # Sender address (use verified domain in production)

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # Public URL of the app (used in emails, redirects)
